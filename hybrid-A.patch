+# ---------- FLOW=hybrid: triage + resolution agent ----------
+_ACTION_INTENTS = ("return", "complaint")
+
+
+def triage_node(state: AgentState) -> dict:
+    """simple: một bước (policy / order / other). case: yêu cầu cần xử lý nhiều bước, vào resolution agent.
+
+    Chỉ intent quyết định định tuyến, vì chỉ return / complaint có pipeline hành động. Nhãn `complexity`
+    của LLM được giữ trong state để so sánh khi đánh giá triage, không tự đổi đường đi.
+    """
+    triage = "case" if state.get("intent") in _ACTION_INTENTS else "simple"
+    return {"triage": triage, "trace": _trace(state, f"triage({triage})")}
+
+
+def _with_tool(state: AgentState, name: str) -> dict:
+    """Ghi tên tool vào tool_calls (chỉ ở nhánh case của hybrid; flow cố định để evals suy ra từ trace)."""
+    if state.get("triage") != "case":
+        return {}
+    return {"tool_calls": [*state.get("tool_calls", []), name]}
+
+
+def _can_lookup(state: AgentState) -> bool:
+    if not state.get("order_id"):
+        return False
+    return bool(state.get("phone_last4")) or not config.REQUIRE_PHONE_VERIFY
+
+
+def _finish_update(state: AgentState) -> dict:
+    """Khi agent kết thúc: đặt need_verify / status giống gather_node để route_after_gather dùng lại."""
+    if state["intent"] == "return":
+        if not state.get("order_id") or (config.REQUIRE_PHONE_VERIFY and not state.get("phone_last4")):
+            return {"need_verify": True, "order": None, "status": "need_info"}
+        if state.get("order") is None:
+            return {"need_verify": False, "order": None, "status": "need_info"}
+    return {"need_verify": False}
+
+
+def agent_node(state: AgentState) -> dict:
+    """Resolution agent, MỖI LẦN GỌI LÀ MỘT BƯỚC. Graph tự quay lại node này đến khi agent finish hoặc hết bước.
+
+    Agent chỉ có 2 tool ĐỌC (search_policy, get_order). Tham số tool do code điền từ thông tin khách đã cung cấp,
+    agent không tự bịa mã đơn. Tạo phiếu / chuyển duyệt vẫn do code quyết định ở decide -> execute | request_approval.
+    """
+    step = state.get("step_count", 0)
+    if step >= config.MAX_AGENT_STEPS:
+        return {"step_limit_hit": True, "handoff": True, "status": "handoff",
+                "trace": _trace(state, "agent(step_limit)")}
+
+    called = list(state.get("tool_calls", []))
+    notes = list(state.get("agent_notes", []))
+    can_lookup = _can_lookup(state)
+    action = llm.plan_next_action(
+        _text(state), state["intent"], {"called": called, "can_lookup": can_lookup, "observations": notes}
+    )
+
+    tool = action.tool
+    if tool == "finish":  # code bảo đảm tối thiểu: không finish khi chưa tra chính sách / chưa tra được đơn
+        if "search_policy" not in called:
+            tool = "search_policy"
+        elif can_lookup and "get_order" not in called:
+            tool = "get_order"
+
+    out: dict = {"step_count": step + 1}
+    if tool == "search_policy" and "search_policy" not in called:
+        chunks = _retrieve(_text(state))
+        out.update(context=chunks, tool_calls=[*called, "search_policy"],
+                   agent_notes=[*notes, f"search_policy: {len(chunks)} đoạn chính sách"])
+    elif tool == "get_order" and can_lookup and "get_order" not in called:
+        order = tools.get_order(state["order_id"], state.get("phone_last4"))
+        out.update(order=order, tool_calls=[*called, "get_order"],
+                   agent_notes=[*notes, "get_order: tìm thấy đơn" if order else "get_order: không tìm thấy đơn"])
+    elif tool == "finish":
+        out.update(agent_done=True)
+        out.update(_finish_update({**state, **out}))
+    else:  # tool không hợp lệ hoặc đã gọi rồi: tốn một bước, không làm gì
+        out["agent_notes"] = [*notes, f"{tool}: bị bỏ qua (đã gọi hoặc chưa đủ điều kiện)"]
+    out["trace"] = _trace(state, f"agent({tool})")
+    return out
+
+
