# Copy file này thành .env rồi điền key. KHÔNG commit .env.

# "stub" = chạy offline bằng luật từ khóa (dùng để dev/test không cần API key)
# "gemini" hoặc "openai" = gọi LLM thật (Người A hoàn thiện trong app/llm.py)
LLM_PROVIDER=stub
LLM_MODEL=gemini-2.0-flash

GOOGLE_API_KEY=
OPENAI_API_KEY=

# Langfuse (Người D). Để trống thì tracing tự tắt.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Có bắt buộc xác minh 4 số cuối SĐT trước khi tra đơn không
REQUIRE_PHONE_VERIFY=true

# true khi chạy eval: gọi LLM lỗi thì báo lỗi thay vì rơi về luật từ khóa
LLM_STRICT=false
# Loại đoạn chính sách có score thấp hơn mức này (0 = tắt, bật khi B trả score trong retrieve)
RAG_MIN_SCORE=0
# Quy tắc nghiệp vụ, phải khớp data/policies
RETURN_WINDOW_DAYS=7
APPROVAL_THRESHOLD_VND=1000000
