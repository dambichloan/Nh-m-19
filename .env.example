# Copy file này thành .env rồi điền key. KHÔNG commit .env.

# "stub" = chạy offline bằng luật từ khóa (dùng để dev/test không cần API key)
# "gemini" hoặc "openai" = gọi LLM thật (hoàn thiện trong app/llm.py)
LLM_PROVIDER=stub
LLM_MODEL=gemini-2.0-flash

GOOGLE_API_KEY=
OPENAI_API_KEY=

# Langfuse. Để trống PUBLIC/SECRET key thì tracing tự tắt, app vẫn chạy.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# fixed = flow cố định (baseline) | hybrid = có vòng agent (chưa cài)
FLOW=fixed

# Có bắt buộc xác minh 4 số cuối SĐT trước khi tra đơn không
REQUIRE_PHONE_VERIFY=true

# true khi chạy eval: gọi LLM lỗi thì báo lỗi thay vì rơi về luật từ khóa
LLM_STRICT=false
# Loại đoạn chính sách có score thấp hơn mức này (0 = tắt, bật khi retrieve trả score)
RAG_MIN_SCORE=0

# Ngày giả để demo/eval ổn định (dữ liệu mẫu tính hạn đổi trả theo ngày này). Bỏ trống để dùng ngày thật.
# FAKE_TODAY=2026-11-08

# Quy tắc nghiệp vụ. PHẢI khớp data/rules.md (tests/test_rules_sync.py kiểm tra).
# Nếu .env của bạn có các dòng này, chúng GHI ĐÈ giá trị trong app/config.py.
RETURN_WINDOW_DAYS=7
WARRANTY_DAYS=30
APPROVAL_THRESHOLD_VND=500000
MAX_VERIFY_ATTEMPTS=3
